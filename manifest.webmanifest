{
  "id": "./",
  "name": "Anatomistvitalis Academic Resource Center",
  "short_name": "Anatomistvitalis",
  "description": "Free anatomy, neuroanatomy, embryology, histology and physiology lessons with original diagrams, mnemonics and revision quizzes.",
  "lang": "en",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f4f7fa",
  "theme_color": "#0a2034",
  "categories": [
    "education",
    "medical",
    "books"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Browse lessons",
      "short_name": "Lessons",
      "description": "Open the anatomy and biomedical lesson library",
      "url": "./#library",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Memory aids",
      "short_name": "Mnemonics",
      "description": "Review anatomy and embryology mnemonics",
      "url": "./memory-aids/",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Visual atlas",
      "short_name": "Visual atlas",
      "description": "Open original anatomy and embryology diagrams",
      "url": "./visual-atlas/",
      "icons": [{"src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
